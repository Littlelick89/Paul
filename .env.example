# Claude API Key (https://console.anthropic.com)
ANTHROPIC_API_KEY=sk-ant-your-key-here

# Windows shared folder path (UNC or mapped drive)
# Examples:
#   SHARED_FOLDER_PATH=\\\\server\\Training\\output.xlsx
#   SHARED_FOLDER_PATH=Z:\\Training\\output.xlsx
SHARED_FOLDER_PATH=

# ---------------------------------------------------------------------------
# Salesforce Uploader credentials
# ---------------------------------------------------------------------------
# SF_DOMAIN: "login" for production, "test" for sandbox
SF_DOMAIN=login

SF_USERNAME=your.email@company.com
SF_PASSWORD=your-salesforce-password
SF_SECURITY_TOKEN=your-security-token
